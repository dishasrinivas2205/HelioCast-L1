# HelioCast-L1 Operational Environment Configuration
HELIOCAST_ENV=development
LOG_LEVEL=INFO

# Operational Observation Parameters
TELEMETRY_CADENCE_SEC=10
QUIET_SUN_BASELINE_WINDOW_SEC=900

# Precursor Forecasting Parameters
FORECAST_HORIZONS_MIN=15,30,45
ALERT_PROBABILITY_THRESHOLD=0.60
MIN_HISTORY_STEPS=60

# Data Storage
DATABASE_PATH=data/catalog/aditya_flares.db
RAW_DATA_DIR=data/raw
SAMPLE_DATA_DIR=data/sample

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Alerting & Webhooks
WEBHOOK_ALERT_ENABLED=false
WEBHOOK_ALERT_URL=https://orbital-ops.isro.gov.in/alerts
